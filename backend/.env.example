NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/project-platform
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-to-another-long-random-secret-at-least-32-characters
CLIENT_URL=http://localhost:4200
# Number of trusted reverse-proxy hops (0 when the API is exposed directly).
TRUST_PROXY=1
# Optional overrides for demo seed passwords. Never use these values in production.
# SEED_ADMIN_PASSWORD=change-me
# SEED_PM_PASSWORD=change-me
# SEED_DEVELOPER_PASSWORD=change-me
# SEED_CLIENT_PASSWORD=change-me
# Use "ethereal" for a local preview inbox, or "smtp" with Mailtrap-like credentials below.
MAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM="Developer Portal" <no-reply@developer-portal.local>
